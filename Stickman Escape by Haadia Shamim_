import pygame
import random

# Pygame components 
pygame.init()
pygame.font.init()

# Screen 
WIDTH, HEIGHT = 800, 400
FPS = 60
WHITE = (255, 255, 255)
BLACK = (0, 0, 0)
GREEN = (34, 139, 34)
RED = (220, 20, 60)
SKY_BLUE = (238, 217, 179)
GROUND_BROWN = (141, 110, 99)

screen = pygame.display.set_mode((WIDTH, HEIGHT))
pygame.display.set_caption("Stickman Escape! - Jupyter Version")
clock = pygame.time.Clock()
font = pygame.font.SysFont("Arial", 18, bold=True)
large_font = pygame.font.SysFont("Arial", 32, bold=True)

class Obstacle:
    def __init__(self, obs_type):
        self.type = obs_type  # 0 = ground (jump over), 1 = mid-air (duck under)
        self.width = 20
        self.height = 30
        self.x = WIDTH
        self.y = 310 if self.type == 0 else 240
    
    def move(self, speed):
        self.x -= speed

    def draw(self, surface):
        pygame.draw.rect(surface, RED, (self.x, self.y, self.width, self.height))

def draw_stickman(surface, x, y, is_chaser, is_ducking, is_jumping, ticks):
    line_w = 6 if is_chaser else 3
    color = GREEN if is_chaser else BLACK
    
    head_r = 10 if is_chaser else 7
    head_y = y + 8 if is_ducking else y
    body_top = head_y + head_r
    body_bottom = y + 22 if is_ducking else y + 45
    
    # Head
    pygame.draw.circle(surface, color, (int(x), int(head_y)), head_r)
    # Spine
    pygame.draw.line(surface, color, (x, body_top), (x, body_bottom), line_w)
    # Arms
    pygame.draw.line(surface, color, (x - 12, body_top + 10), (x + 12, body_top + 10), line_w)
    
    # Legs 
    if is_jumping:
        pygame.draw.line(surface, color, (x, body_bottom), (x - 8, body_bottom + 12), line_w)
        pygame.draw.line(surface, color, (x, body_bottom), (x + 8, body_bottom + 12), line_w)
    elif is_ducking:
        pygame.draw.line(surface, color, (x, body_bottom), (x - 12, body_bottom + 6), line_w)
        pygame.draw.line(surface, color, (x, body_bottom), (x + 12, body_bottom + 6), line_w)
    else:
        phase = (ticks // 100) % 2 == 0
        pygame.draw.line(surface, color, (x, body_bottom), (x - 12 if phase else x + 6, body_bottom + 15), line_w)
        pygame.draw.line(surface, color, (x, body_bottom), (x + 12 if phase else x - 6, body_bottom + 15), line_w)

def show_screen(title_text, sub_text):
    screen.fill(BLACK)
    t_surf = large_font.render(title_text, True, WHITE)
    s_surf = font.render(sub_text, True, (200, 200, 200))
    screen.blit(t_surf, (WIDTH // 2 - t_surf.get_width() // 2, HEIGHT // 3))
    screen.blit(s_surf, (WIDTH // 2 - s_surf.get_width() // 2, HEIGHT // 2))
    pygame.display.flip()
    
    waiting = True
    while waiting:
        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                return False
            if event.type == pygame.KEYDOWN:
                waiting = False
    return True

def run_game():
    if not show_screen("STICKMAN ESCAPE", "Press ANY KEY to start. Instructions: Up=Jump, Down=Duck, Space=Speed Boost"):
        return

    # Points system
    points = 1000
    obstacles_hit = 0
    chaser_speed_multiplier = 1.0

    # State Variables
    player_base_speed = 5.0
    player_speed = 5.0
    player_x, player_y = 250, 290
    
    is_jumping = False
    is_ducking = False
    jump_vy = 0
    gravity = 0.6
    
    chaser_x, chaser_y = 50, 280
    
    boost_active = False
    boost_timer = 0
    boost_cooldown = 0
    
    game_duration = 120 * 1000  # Updated to 2 minutes in milliseconds
    start_ticks = pygame.time.get_ticks()
    
    obstacles = []
    obstacle_timer = 0
    
    running = True
    while running:
        clock.tick(FPS)
        ticks = pygame.time.get_ticks()
        elapsed_ms = ticks - start_ticks
        time_left_sec = max(0, int((game_duration - elapsed_ms) / 1000))
        
        # Check Points Game Over condition
        if points <= 0:
            show_screen("GAME OVER", "Out of points! Press ANY KEY to exit.")
            break

        #  Win condition 
        if time_left_sec <= 0:
            show_screen("🏆 YOU ESCAPED!", f"Speed: {player_speed:.1f} | Points: {points} | Press ANY KEY to exit.")
            break
            
        # 1. Event Loop
        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                running = False
                
        keys = pygame.key.get_pressed()
        
        # Player Actions
        if keys[pygame.K_UP] and not is_jumping and not is_ducking:
            is_jumping = True
            jump_vy = -12
        if keys[pygame.K_DOWN] and not is_jumping:
            is_ducking = True
        else:
            is_ducking = False
            
        if keys[pygame.K_SPACE] and not boost_active and boost_cooldown <= ticks:
            boost_active = True
            boost_timer = ticks + 5000  # 5 Seconds
            boost_cooldown = ticks + 15000 # 15 Seconds internal window
            
        # 2. Logic Update
        if boost_active:
            if ticks > boost_timer:
                boost_active = False
            else:
                player_speed = player_base_speed * 2.0
        else:
            player_speed = player_base_speed
            
        # Jumping n falling time
        if is_jumping:
            player_y += jump_vy
            jump_vy += gravity
            if player_y >= 290:
                player_y = 290
                is_jumping = False
                
        #  Chaser Speed 
        # Increases speed by 0.5x for every block of 2 obstacles hit
        chaser_speed_multiplier = 1.0 + (0.5 * (obstacles_hit // 2))
        chaser_speed = (player_base_speed / 2.0) * chaser_speed_multiplier
        
        chaser_x += (chaser_speed - player_speed) * 0.4
        
        if chaser_x < -50:
            chaser_x = -50
            
        # obstacles
        obstacle_timer -= 1
        if obstacle_timer <= 0:
            obstacles.append(Obstacle(random.randint(0, 1)))
            obstacle_timer = random.randint(60, 120)
            
        # Move and manage obstacles
        for obs in obstacles[:]:
            obs.move(player_speed)
            if obs.x < -20:
                obstacles.remove(obs)
                continue
                
            p_rect = pygame.Rect(player_x - 10, player_y, 20, 45 if not is_ducking else 25)
            o_rect = pygame.Rect(obs.x, obs.y, obs.width, obs.height)
            c_rect = pygame.Rect(chaser_x - 15, chaser_y, 30, 60)
            
            # Obstacle impact on score
            if p_rect.colliderect(o_rect):
                player_x -= 15       # Knocked back
                points -= 10         # Deduct points
                obstacles_hit += 1   # Increase collision tracker counter
                obstacles.remove(obs)
                
            # Game Over 
            if c_rect.colliderect(p_rect) or player_x <= chaser_x:
                show_screen("GAME OVER", "The chaser caught you! Press ANY KEY to exit.")
                running = False
                break
                
        if player_x < 250 and running:
            player_x += 0.5
            
        # 3. Drawing Elements
        screen.fill(SKY_BLUE)
        pygame.draw.rect(screen, GROUND_BROWN, (0, 335, WIDTH, HEIGHT - 335))
        
        draw_stickman(screen, player_x, player_y, is_chaser=False, is_ducking=is_ducking, is_jumping=is_jumping, ticks=ticks)
        draw_stickman(screen, chaser_x, chaser_y, is_chaser=True, is_ducking=False, is_jumping=False, ticks=ticks)
        
        for obs in obstacles:
            obs.draw(screen)
            
        # UI Information Updates
        time_text = font.render(f"Time Remaining: {time_left_sec}s", True, BLACK)
        points_text = font.render(f"Points: {points}", True, BLACK)
        speed_text = font.render(f"Chaser Speed Multiplier: {chaser_speed_multiplier:.1f}x", True, RED if chaser_speed_multiplier > 1.0 else BLACK)
        
        screen.blit(time_text, (20, 20))
        screen.blit(points_text, (20, 45))
        screen.blit(speed_text, (WIDTH - 280, 20))
        
        pygame.display.flip()

try:
    run_game()
finally:
    pygame.quit()

