    "import pygame\n",
    "import random\n",
    "\n",
    "# Initialize Pygame components cleanly\n",
    "pygame.init()\n",
    "pygame.font.init()\n",
    "\n",
    "# Screen Dimensions and Configurations\n",
    "WIDTH, HEIGHT = 800, 400\n",
    "FPS = 60\n",
    "WHITE = (255, 255, 255)\n",
    "BLACK = (0, 0, 0)\n",
    "GREEN = (34, 139, 34)\n",
    "RED = (220, 20, 60)\n",
    "SKY_BLUE = (238, 217, 179)\n",
    "GROUND_BROWN = (141, 110, 99)\n",
    "\n",
    "screen = pygame.display.set_mode((WIDTH, HEIGHT))\n",
    "pygame.display.set_caption(\"Stickman Escape! - Jupyter Version\")\n",
    "clock = pygame.time.Clock()\n",
    "font = pygame.font.SysFont(\"Arial\", 18, bold=True)\n",
    "large_font = pygame.font.SysFont(\"Arial\", 32, bold=True)\n",
    "\n",
    "class Obstacle:\n",
    "    def __init__(self, obs_type):\n",
    "        self.type = obs_type  # 0 = ground (jump over), 1 = mid-air (duck under)\n",
    "        self.width = 20\n",
    "        self.height = 30\n",
    "        self.x = WIDTH\n",
    "        self.y = 310 if self.type == 0 else 240\n",
    "    \n",
    "    def move(self, speed):\n",
    "        self.x -= speed\n",
    "\n",
    "    def draw(self, surface):\n",
    "        pygame.draw.rect(surface, RED, (self.x, self.y, self.width, self.height))\n",
    "\n",
    "def draw_stickman(surface, x, y, is_chaser, is_ducking, is_jumping, ticks):\n",
    "    line_w = 6 if is_chaser else 3\n",
    "    color = GREEN if is_chaser else BLACK\n",
    "    \n",
    "    head_r = 10 if is_chaser else 7\n",
    "    head_y = y + 8 if is_ducking else y\n",
    "    body_top = head_y + head_r\n",
    "    body_bottom = y + 22 if is_ducking else y + 45\n",
    "    \n",
    "    # Head\n",
    "    pygame.draw.circle(surface, color, (int(x), int(head_y)), head_r)\n",
    "    # Spine\n",
    "    pygame.draw.line(surface, color, (x, body_top), (x, body_bottom), line_w)\n",
    "    # Arms\n",
    "    pygame.draw.line(surface, color, (x - 12, body_top + 10), (x + 12, body_top + 10), line_w)\n",
    "    \n",
    "    # Legs \n",
    "    if is_jumping:\n",
    "        pygame.draw.line(surface, color, (x, body_bottom), (x - 8, body_bottom + 12), line_w)\n",
    "        pygame.draw.line(surface, color, (x, body_bottom), (x + 8, body_bottom + 12), line_w)\n",
    "    elif is_ducking:\n",
    "        pygame.draw.line(surface, color, (x, body_bottom), (x - 12, body_bottom + 6), line_w)\n",
    "        pygame.draw.line(surface, color, (x, body_bottom), (x + 12, body_bottom + 6), line_w)\n",
    "    else:\n",
    "        phase = (ticks // 100) % 2 == 0\n",
    "        pygame.draw.line(surface, color, (x, body_bottom), (x - 12 if phase else x + 6, body_bottom + 15), line_w)\n",
    "        pygame.draw.line(surface, color, (x, body_bottom), (x + 12 if phase else x - 6, body_bottom + 15), line_w)\n",
    "\n",
    "def show_screen(title_text, sub_text):\n",
    "    screen.fill(BLACK)\n",
    "    t_surf = large_font.render(title_text, True, WHITE)\n",
    "    s_surf = font.render(sub_text, True, (200, 200, 200))\n",
    "    screen.blit(t_surf, (WIDTH // 2 - t_surf.get_width() // 2, HEIGHT // 3))\n",
    "    screen.blit(s_surf, (WIDTH // 2 - s_surf.get_width() // 2, HEIGHT // 2))\n",
    "    pygame.display.flip()\n",
    "    \n",
    "    waiting = True\n",
    "    while waiting:\n",
    "        for event in pygame.event.get():\n",
    "            if event.type == pygame.QUIT:\n",
    "                return False\n",
    "            if event.type == pygame.KEYDOWN:\n",
    "                waiting = False\n",
    "    return True\n",
    "\n",
    "def run_game():\n",
    "    if not show_screen(\"STICKMAN ESCAPE\", \"Press ANY KEY to start. Instructions: Up=Jump, Down=Duck, Space=Speed Boost\"):\n",
    "        return\n",
    "\n",
    "    # Points system\n",
    "    points = 1000\n",
    "    obstacles_hit = 0\n",
    "    chaser_speed_multiplier = 1.0\n",
    "\n",
    "    # State Variables\n",
    "    player_base_speed = 5.0\n",
    "    player_speed = 5.0\n",
    "    player_x, player_y = 250, 290\n",
    "    \n",
    "    is_jumping = False\n",
    "    is_ducking = False\n",
    "    jump_vy = 0\n",
    "    gravity = 0.6\n",
    "    \n",
    "    chaser_x, chaser_y = 50, 280\n",
    "    \n",
    "    boost_active = False\n",
    "    boost_timer = 0\n",
    "    boost_cooldown = 0\n",
    "    \n",
    "    game_duration = 120 * 1000  # Updated to 2 minutes in milliseconds\n",
    "    start_ticks = pygame.time.get_ticks()\n",
    "    \n",
    "    obstacles = []\n",
    "    obstacle_timer = 0\n",
    "    \n",
    "    running = True\n",
    "    while running:\n",
    "        clock.tick(FPS)\n",
    "        ticks = pygame.time.get_ticks()\n",
    "        elapsed_ms = ticks - start_ticks\n",
    "        time_left_sec = max(0, int((game_duration - elapsed_ms) / 1000))\n",
    "        \n",
    "        # Check Points Game Over condition\n",
    "        if points <= 0:\n",
    "            show_screen(\"GAME OVER\", \"Out of points! Press ANY KEY to exit.\")\n",
    "            break\n",
    "\n",
    "        #  Win condition \n",
    "        if time_left_sec <= 0:\n",
    "            show_screen(\"🏆 YOU ESCAPED!\", f\"Speed: {player_speed:.1f} | Points: {points} | Press ANY KEY to exit.\")\n",
    "            break\n",
    "            \n",
    "        # 1. Event Loop\n",
    "        for event in pygame.event.get():\n",
    "            if event.type == pygame.QUIT:\n",
    "                running = False\n",
    "                \n",
    "        keys = pygame.key.get_pressed()\n",
    "        \n",
    "        # Player Actions\n",
    "        if keys[pygame.K_UP] and not is_jumping and not is_ducking:\n",
    "            is_jumping = True\n",
    "            jump_vy = -12\n",
    "        if keys[pygame.K_DOWN] and not is_jumping:\n",
    "            is_ducking = True\n",
    "        else:\n",
    "            is_ducking = False\n",
    "            \n",
    "        if keys[pygame.K_SPACE] and not boost_active and boost_cooldown <= ticks:\n",
    "            boost_active = True\n",
    "            boost_timer = ticks + 5000  # 5 Seconds\n",
    "            boost_cooldown = ticks + 15000 # 15 Seconds internal window\n",
    "            \n",
    "        # 2. Logic Update\n",
    "        if boost_active:\n",
    "            if ticks > boost_timer:\n",
    "                boost_active = False\n",
    "            else:\n",
    "                player_speed = player_base_speed * 2.0\n",
    "        else:\n",
    "            player_speed = player_base_speed\n",
    "            \n",
    "        # Jumping n falling time\n",
    "        if is_jumping:\n",
    "            player_y += jump_vy\n",
    "            jump_vy += gravity\n",
    "            if player_y >= 290:\n",
    "                player_y = 290\n",
    "                is_jumping = False\n",
    "                \n",
    "        #  Chaser Speed \n",
    "        # Increases speed by 0.5x for every block of 2 obstacles hit\n",
    "        chaser_speed_multiplier = 1.0 + (0.5 * (obstacles_hit // 2))\n",
    "        chaser_speed = (player_base_speed / 2.0) * chaser_speed_multiplier\n",
    "        \n",
    "        chaser_x += (chaser_speed - player_speed) * 0.4\n",
    "        \n",
    "        if chaser_x < -50:\n",
    "            chaser_x = -50\n",
    "            \n",
    "        # obstacles\n",
    "        obstacle_timer -= 1\n",
    "        if obstacle_timer <= 0:\n",
    "            obstacles.append(Obstacle(random.randint(0, 1)))\n",
    "            obstacle_timer = random.randint(60, 120)\n",
    "            \n",
    "        # Move and manage obstacles\n",
    "        for obs in obstacles[:]:\n",
    "            obs.move(player_speed)\n",
    "            if obs.x < -20:\n",
    "                obstacles.remove(obs)\n",
    "                continue\n",
    "                \n",
    "            p_rect = pygame.Rect(player_x - 10, player_y, 20, 45 if not is_ducking else 25)\n",
    "            o_rect = pygame.Rect(obs.x, obs.y, obs.width, obs.height)\n",
    "            c_rect = pygame.Rect(chaser_x - 15, chaser_y, 30, 60)\n",
    "            \n",
    "            # Obstacle impact on score\n",
    "            if p_rect.colliderect(o_rect):\n",
    "                player_x -= 15       # Knocked back\n",
    "                points -= 10         # Deduct points\n",
    "                obstacles_hit += 1   # Increase collision tracker counter\n",
    "                obstacles.remove(obs)\n",
    "                \n",
    "            # Game Over \n",
    "            if c_rect.colliderect(p_rect) or player_x <= chaser_x:\n",
    "                show_screen(\"GAME OVER\", \"The chaser caught you! Press ANY KEY to exit.\")\n",
    "                running = False\n",
    "                break\n",
    "                \n",
    "        if player_x < 250 and running:\n",
    "            player_x += 0.5\n",
    "            \n",
    "        # 3. Drawing Elements\n",
    "        screen.fill(SKY_BLUE)\n",
    "        pygame.draw.rect(screen, GROUND_BROWN, (0, 335, WIDTH, HEIGHT - 335))\n",
    "        \n",
    "        draw_stickman(screen, player_x, player_y, is_chaser=False, is_ducking=is_ducking, is_jumping=is_jumping, ticks=ticks)\n",
    "        draw_stickman(screen, chaser_x, chaser_y, is_chaser=True, is_ducking=False, is_jumping=False, ticks=ticks)\n",
    "        \n",
    "        for obs in obstacles:\n",
    "            obs.draw(screen)\n",
    "            \n",
    "        # UI Information Updates\n",
    "        time_text = font.render(f\"Time Remaining: {time_left_sec}s\", True, BLACK)\n",
    "        points_text = font.render(f\"Points: {points}\", True, BLACK)\n",
    "        speed_text = font.render(f\"Chaser Speed Multiplier: {chaser_speed_multiplier:.1f}x\", True, RED if chaser_speed_multiplier > 1.0 else BLACK)\n",
    "        \n",
    "        screen.blit(time_text, (20, 20))\n",
    "        screen.blit(points_text, (20, 45))\n",
    "        screen.blit(speed_text, (WIDTH - 280, 20))\n",
    "        \n",
    "        pygame.display.flip()\n",
    "\n",
    "try:\n",
    "    run_game()\n",
    "finally:\n",
    "    pygame.quit()\n"
   ]
